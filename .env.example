# Backend only. Generate a unique, high-entropy integration key; never put it in VITE_*.
CASH_REVIEW_API_KEY=
# Absolute path to locally prepared weights + baseline.json + baseline.npz
CASH_REVIEW_MODEL_DIR=./models
CASH_REVIEW_DATA_DIR=./runtime
CASH_REVIEW_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CASH_REVIEW_MAX_UPLOAD_BYTES=67108864
CASH_REVIEW_DEADLINE_SECONDS=300
CASH_REVIEW_RETENTION_SECONDS=86400
CASH_REVIEW_TOKEN_TTL_SECONDS=7200
CASH_REVIEW_QUEUE_CAPACITY=8
CASH_REVIEW_WORKERS=1
CASH_REVIEW_CV_THREADS=2
# Preserve native source frames up to this side; bounded to 640–1920, never upscale.
CASH_REVIEW_EVIDENCE_MAX_SIDE=1280
